{
  "name": "@whats-for-dinner/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./db": "./src/db/index.ts",
    "./db/*": "./src/db/*.ts",
    "./partners/*": "./src/partners/*.ts",
    "./routes/*": "./src/routes/*.ts",
    "./observability": "./src/observability/index.ts",
    "./security/*": "./src/security/*.ts",
    "./queue": "./src/queue/index.ts",
    "./queue/*": "./src/queue/*.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/*": "./src/auth/*.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-prometheus": "^0.56.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.56.0",
    "@opentelemetry/sdk-metrics": "^1.26.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/resources": "^1.26.0",
    "@opentelemetry/semantic-conventions": "^1.26.0",
    "@sendgrid/mail": "^8.1.3",
    "bullmq": "^5.22.0",
    "drizzle-kit": "^0.28.0",
    "drizzle-orm": "^0.36.0",
    "express": "^4.18.2",
    "fastify": "^5.12.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^6.7.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "postgres": "^3.4.5",
    "zod": "^3.22.4",
    "zod-to-openapi": "^0.2.1",
    "fast-xml-parser": "^5.3.6",
    "csv-parse": "^7.0.2",
    "stripe": "^14.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20",
    "supertest": "^6.3.4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
