{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "noImplicitThis": false,
    "useUnknownInCatchVariables": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,
    "noUncheckedIndexedAccess": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@whats-for-dinner/server": [
        "../../packages/server/src/index.ts"
      ],
      "@whats-for-dinner/server/*": [
        "../../packages/server/src/*"
      ],
      "@whats-for-dinner/analytics-consent": [
        "../../packages/analytics/consent/consentModel.ts"
      ],
      "@whats-for-dinner/analytics-consent/store": [
        "../../packages/analytics/consent/consentStore.ts"
      ],
      "@whats-for-dinner/analytics-consent/model": [
        "../../packages/analytics/consent/consentModel.ts"
      ],
      "@whats-for-dinner/analytics-consent/*": [
        "../../packages/analytics/consent/*"
      ],
      "@whats-for-dinner/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@whats-for-dinner/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@whats-for-dinner/utils": [
        "../../packages/utils/src/index.ts"
      ],
      "@whats-for-dinner/utils/*": [
        "../../packages/utils/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "dist/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/app/admin/**",
    "src/app/developers/**",
    "src/app/partners/**",
    "src/app/billing/**",
    "src/app/auth/**",
    "src/app/favorites/**",
    "src/app/landing/**",
    "src/app/offline/**",
    "src/app/pantry/**",
    "src/app/ugc/**",
    "src/app/api/**",
    "src/lib/agents/**",
    "src/lib/ai*.ts",
    "src/lib/autonomous*.ts",
    "src/lib/cognitive*.ts",
    "src/lib/compliance*.ts",
    "src/lib/federated*.ts",
    "src/lib/feedback*.ts",
    "src/lib/franchise*.ts",
    "src/lib/growth*.ts",
    "src/lib/health*.ts",
    "src/lib/marketing*.ts",
    "src/lib/model*.ts",
    "src/lib/monetization/**",
    "src/lib/monetization*.ts",
    "src/lib/monitoring/**",
    "src/lib/monitoring*.ts",
    "src/lib/observability/**",
    "src/lib/observability*.ts",
    "src/lib/performance/**",
    "src/lib/performance*.ts",
    "src/lib/privacy/**",
    "src/lib/privacy*.ts",
    "src/lib/predictive*.ts",
    "src/lib/prompt*.ts",
    "src/lib/secrets*.ts",
    "src/lib/security*.ts",
    "src/lib/social*.ts",
    "src/lib/ugc*.ts",
    "src/lib/workflow*.ts",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/__tests__/**",
    "tests/**",
    "../../packages/**",
    "supabase/**",
    ".next/**",
    "emails/**",
    "scripts/**",
    "capacitor.config.ts",
    "src/app/(marketing)/**",
    "src/lib/capacitor/**",
    "src/lib/marketing/**"
  ]
}
