{
  "name": "@whats-for-dinner/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "type:coverage": "tsc --noEmit --pretty false 2>&1 | grep -E 'error TS|Found [0-9]+ error' || echo 'No type errors'",
    "obs:check": "node scripts/check-telemetry-coverage.mjs",
    "autonomous:start": "node -e \"require('./src/lib/index.ts').initializeAutonomousSystem()\"",
    "autonomous:status": "node -e \"console.log(require('./src/lib/index.ts').getSystemStatusSummary())\"",
    "autonomous:shutdown": "node -e \"require('./src/lib/index.ts').shutdownAutonomousSystem()\"",
    "autonomous:audit": "node -e \"require('./src/lib/observabilityAudit.ts').observabilityAudit.runDailyAudit().then(console.log)\"",
    "autonomous:learn": "node -e \"require('./src/lib/cognitiveContinuity.ts').cognitiveContinuity.runLearningSession().then(console.log)\"",
    "autonomous:optimize": "node -e \"require('./src/lib/predictiveOptimization.ts').predictiveOptimization.generateOptimizationRecommendations().then(console.log)\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "cap:init": "npx cap init",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:update": "npx cap update",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:build:ios": "pnpm build && npx cap sync ios && cd ios && xcodebuild -workspace App.xcworkspace -scheme App -configuration Release -archivePath App.xcarchive archive",
    "cap:build:android": "pnpm build && npx cap sync android"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --cache"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@capacitor-community/http": "^1.4.1",
    "@capacitor/app": "^7.1.0",
    "@capacitor/app-launcher": "^7.0.2",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/local-notifications": "^7.0.3",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/push-notifications": "^7.0.3",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@sentry/nextjs": "^8.55.0",
    "@stripe/stripe-js": "^2.4.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/auth-helpers-react": "^0.5.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.76.1",
    "@tanstack/react-query": "^5.17.0",
    "@whats-for-dinner/config": "workspace:*",
    "@whats-for-dinner/server": "workspace:*",
    "@whats-for-dinner/theme": "workspace:*",
    "@whats-for-dinner/ui": "workspace:*",
    "@whats-for-dinner/utils": "workspace:*",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.548.0",
    "next": "16.3.3",
    "next-pwa": "^5.6.0",
    "openai": "^6.7.0",
    "posthog-js": "^1.200.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^2.8.0",
    "resend": "^6.2.2",
    "sonner": "^1.4.0",
    "stripe": "^14.21.0",
    "tailwind-merge": "^3.3.1",
    "uuid": "^14.0.0",
    "web-vitals": "^4.2.4",
    "zod": "^3.22.4",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.1.4"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@playwright/test": "^1.40.0",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.16",
    "eslint": "^9",
    "eslint-config-next": "15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "framer-motion": "^11.11.17",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.2",
    "postcss": "^8.5.27",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.4.5",
    "typescript": "^5"
  }
}
