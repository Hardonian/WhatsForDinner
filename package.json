    "agent:cost": "tsx -e \"import('./agents/unified-agent.ts').then(m => { const a = new m.UnifiedAgent(); import('./agents/cost-agent.ts').then(c => { const ca = new c.CostAgent(process.cwd(), a.getRepoContext()); ca.run(); }); })\"",
